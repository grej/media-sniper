{
  "name": "media-sniper-extension",
  "version": "1.13.0",
  "type": "module",
  "description": "Browser extension for detecting, downloading, recording, and clipping HLS, DASH, and direct video",
  "scripts": {
    "build": "npm run build:standard",
    "build:standard": "vite build --mode standard",
    "build:companion": "vite build --mode companion",
    "build:variants": "npm run build:standard && npm run build:companion",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:serve": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "test:media": "vitest run tests/media",
    "package": "npm run type-check && npm test -- --run && npm run package:extensions",
    "package:extensions": "npm run build:variants && npm run package:standard && npm run package:companion",
    "package:standard": "node scripts/package.mjs --variant standard",
    "package:companion": "node scripts/package.mjs --variant companion",
    "package:check": "npm run package:check:standard && npm run package:check:companion && npm run release:check",
    "package:check:standard": "node scripts/package.mjs --check --variant standard",
    "package:check:companion": "node scripts/package.mjs --check --variant companion",
    "release:check": "node scripts/check-companion-release.mjs",
    "compatibility:generate": "node scripts/generate-compatibility.mjs",
    "package:conda:stage": "node scripts/stage-conda-installer.mjs",
    "package:conda:check": "node scripts/check-conda-installer.mjs"
  },
  "keywords": [
    "browser-extension",
    "video-downloader",
    "video-clipper",
    "hls",
    "dash",
    "google-drive"
  ],
  "author": "grej",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.268",
    "@types/m3u8-parser": "^7.2.5",
    "@types/node": "^20.19.24",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^7.2.2",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "idb": "^8.0.3",
    "m3u8-parser": "^7.2.0",
    "mediabunny": "1.54.0",
    "mpd-parser": "^1.3.1",
    "url-toolkit": "^2.2.5",
    "uuid": "^13.0.0"
  }
}
