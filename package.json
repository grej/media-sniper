{
  "name": "media-sniper-extension",
  "version": "1.12.0",
  "type": "module",
  "description": "Browser extension for detecting, downloading, recording, and clipping HLS, DASH, and direct video",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:serve": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "test:media": "vitest run tests/media",
    "package": "npm run type-check && npm test -- --run && npm run build && node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check"
  },
  "keywords": [
    "browser-extension",
    "video-downloader",
    "video-clipper",
    "hls",
    "dash",
    "google-drive"
  ],
  "author": "grej",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.268",
    "@types/m3u8-parser": "^7.2.5",
    "@types/node": "^20.19.24",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^7.2.2",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "idb": "^8.0.3",
    "m3u8-parser": "^7.2.0",
    "mediabunny": "1.54.0",
    "mpd-parser": "^1.3.1",
    "url-toolkit": "^2.2.5",
    "uuid": "^13.0.0"
  }
}
